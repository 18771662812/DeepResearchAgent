# 复制为 .env 后填写

# ---- LLM (DeepSeek) ----
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# none（关闭思考，最快最省）| low | high | max
LLM_REASONING_EFFORT=low

# ---- 搜索 ----
# ddgs（免 key，较慢，适合本地试用）| tavily（每月有免费额度，推荐）| bocha（博查，国内）
SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=
BOCHA_API_KEY=
SEARCH_MAX_RESULTS=5
# ddgs 使用的搜索引擎，逗号分隔；需要代理才能访问时填写 DDGS_PROXY，留空则读取 HTTPS_PROXY
DDGS_BACKEND=yahoo,bing
DDGS_PROXY=

# ---- Agent ----
# 请求未指定模式时的默认值：multi（多 Agent 深度研究）| single（单 Agent 快速研究）
AGENT_MODE=multi
FETCH_MAX_CHARS=8000
TOOL_TIMEOUT=60
# 单 Agent 模式：最大循环轮数
AGENT_MAX_STEPS=10
# 多 Agent 模式
PLANNER_MAX_SUB_QUESTIONS=4
RESEARCHER_MAX_STEPS=5
RESEARCHER_CONCURRENCY=3
RESEARCH_MAX_ROUNDS=2
REFLECTOR_MAX_FOLLOW_UPS=2

# ---- Server ----
# JSON 数组格式
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
